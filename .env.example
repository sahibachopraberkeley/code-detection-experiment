# Code Detection Experiment - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API Configuration (S3 via API Gateway)
# =============================================================================

# API endpoint for data submission (from SAM deploy output)
# Example: https://xxxxx.execute-api.us-east-1.amazonaws.com/prod/submit
VITE_API_ENDPOINT=

# API key for authentication (from AWS Console or CLI)
# Get key value: aws apigateway get-api-key --api-key <KEY_ID> --include-value
VITE_API_KEY=

# =============================================================================
# Prolific Integration
# =============================================================================

# Set to 'true' to enable Prolific-specific features
VITE_USE_PROLIFIC=false

# Prolific completion URL - replace XXXXXX with your actual completion code
VITE_PROLIFIC_COMPLETION_URL=https://app.prolific.com/submissions/complete?cc=XXXXXX

# Completion code shown to participants
VITE_COMPLETION_CODE=EFFORT2024

# =============================================================================
# Legacy Configuration (deprecated, kept for reference)
# =============================================================================

# Supabase configuration (no longer used - migrated to S3)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_KEY=
