# Code Detection Experiment - Environment Configuration
# Copy this file to .env and fill in your values

# API endpoint for data submission (required for production)
# Example: https://your-backend.com/api/submit
VITE_API_ENDPOINT=

# Prolific Integration
# Set to 'true' to enable Prolific-specific features
VITE_USE_PROLIFIC=false

# Prolific completion URL - replace XXXXXX with your actual completion code
VITE_PROLIFIC_COMPLETION_URL=https://app.prolific.com/submissions/complete?cc=XXXXXX

# Completion code shown to participants
VITE_COMPLETION_CODE=EFFORT2024
